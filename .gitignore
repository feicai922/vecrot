# ---- 模型与权重（体积大，不入库，见 docs/模型下载.md 的网盘链接）----
vecrot/models/*
# ScaleCond 适配器只有 1.4 MB，随仓库一起分发，省掉一次下载
!vecrot/models/adaptor_sc_055m/
!vecrot/models/adaptor_sc_055m/**
# 推理配置是源码不是权重（10 KB），随仓库走，避免用户版本对不上
!vecrot/models/detector_strip_s_scene/
!vecrot/models/detector_strip_s_scene/strip_s_gzda_scene.py

# 推理期重建产物
work/
runs/

